LOC  OBJ            LINE     SOURCE

                       1     ;perform experiment by writing a program using a lookup table that reads an 8-bit number fr
                             om port 1,compute its 2's comple,ment using a lookup table and output the result to por2 in 8051 keil  assembly
0000                   2     ORG 0000H
0000 90000A            3         MOV DPTR, #LOOKUP_TABLE  ; Load the address of the lookup table into DPTR
0003                   4     MAIN:
0003 E590              5         MOV A, P1                 ; Read the 8-bit number from Port 1
0005 93                6         MOVC A, @A+DPTR           ; Use the lookup table to get the 2's complement
0006 F5A0              7         MOV P2, A                 ; Output the result to Port 2
0008 80F9              8         SJMP MAIN                 ; Repeat continuously
000A                   9     LOOKUP_TABLE:
