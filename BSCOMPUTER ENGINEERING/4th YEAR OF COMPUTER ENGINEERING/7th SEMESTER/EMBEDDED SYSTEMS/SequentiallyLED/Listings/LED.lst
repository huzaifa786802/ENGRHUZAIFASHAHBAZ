A51 MACRO ASSEMBLER  LED                                                                  11/13/2024 22:57:26 PAGE     1


MACRO ASSEMBLER A51 V8.2.7.0
OBJECT MODULE PLACED IN .\Objects\LED.obj
ASSEMBLER INVOKED BY: C:\Keil_v5\C51\BIN\A51.EXE LED.a51 SET(SMALL) DEBUG PRINT(.\Listings\LED.lst) OBJECT(.\Objects\LED
                      .obj) EP

LOC  OBJ            LINE     SOURCE

0000                   1     ORG 0000H            ; Start of code memory
0000                   2     START:
0000 759001            3         MOV P1, #01H   ; Initialize the leftmost LED (bit 0 of Port 1)
0003 7801              4         MOV R0, #01H   ; Set up the direction for the sequence (left to right)
0005                   5     LOOP:
0005 F590              6         MOV P1, A      ; Update the Port 1 to the value of A register
0007 1128              7         ACALL DELAY    ; Call the delay subroutine
0009 E590              8         MOV A, P1      ; Load the current state of LEDs into A
000B 33                9         RLC A          ; Rotate left through carry (move to next LED in sequence)
000C F590             10         MOV P1, A      ; Update the Port 1 with the new value
000E 1128             11         ACALL DELAY    ; Call the delay subroutine
0010 3097F2           12         JNB P1.7, LOOP ; Jump back to LOOP if the rightmost LED is not reached
                      13         ; Invert the direction (right to left)
0013 759080           14         MOV P1, #80H   ; Set the rightmost LED
0016 7880             15         MOV R0, #80H   ; Set up the direction for the sequence (right to left)
0018                  16     INVERT_LOOP:
0018 F590             17         MOV P1, A      ; Update Port 1 with the current value
001A 1128             18         ACALL DELAY    ; Call the delay subroutine
001C E590             19         MOV A, P1      ; Load the current state of LEDs into A
001E 13               20         RRC A          ; Rotate right through carry (move to previous LED in sequence)
001F F590             21         MOV P1, A      ; Update the Port 1 with the new value
0021 1128             22         ACALL DELAY    ; Call the delay subroutine
0023 3090F2           23         JNB P1.0, INVERT_LOOP ; Jump back to INVERT_LOOP if the leftmost LED is not reached
                      24         ; Repeat the sequence
0026 80DD             25         SJMP LOOP      ; Jump back to the start of the loop
0028                  26     DELAY:
0028 79C8             27         MOV R1, #200   ; Outer loop count
002A                  28     DELAY1:
002A 7AFA             29         MOV R2, #250   ; Inner loop count
002C                  30     DELAY2:
002C 00               31         NOP            ; No Operation (used for delay)
002D 00               32         NOP
002E 00               33         NOP
002F 00               34         NOP
0030 DAFA             35         DJNZ R2, DELAY2 ; Decrement inner loop counter
0032 D9F6             36         DJNZ R1, DELAY1 ; Decrement outer loop counter
0034 22               37         RET            ; Return from the delay subroutine
                      38     END
